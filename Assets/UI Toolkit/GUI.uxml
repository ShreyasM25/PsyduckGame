<ui:UXML xmlns:ui="UnityEngine.UIElements" xmlns:uie="UnityEditor.UIElements" xsi="http://www.w3.org/2001/XMLSchema-instance" engine="UnityEngine.UIElements" editor="UnityEditor.UIElements" noNamespaceSchemaLocation="../../UIElementsSchema/UIElements.xsd" editor-extension-mode="False">
    <ui:GroupBox name="timer" style="flex-shrink: 1; flex-grow: 1; align-items: flex-end; display: flex;">
        <ui:GroupBox name="topTimeGB" style="margin-left: 0; margin-right: 0; margin-top: 0; margin-bottom: 0; padding-left: 0; padding-top: 0; padding-bottom: 0; width: 100%; height: 50%; align-items: auto; justify-content: flex-start;">
            <ui:Label text="48" display-tooltip-when-elided="true" name="time" style="position: relative; bottom: 3%; font-size: 100px; -unity-font: url(&apos;project://database/Assets/UI%20Toolkit/Fonts/Lemon%20Days.otf?fileID=12800000&amp;guid=0c0e763d87c17ee418dbabe25d0345fa&amp;type=3#Lemon Days&apos;); -unity-font-definition: url(&apos;project://database/Assets/UI%20Toolkit/Fonts/Lemon%20Days%20SDF.asset?fileID=11400000&amp;guid=a44f0cf795c97f442acea67148c6ee45&amp;type=2#Lemon Days SDF&apos;); color: rgb(255, 204, 0); text-shadow: 3px 3px 0 rgb(0, 34, 119); align-items: stretch; margin-right: 12px; margin-top: 12px;" />
        </ui:GroupBox>
        <ui:GroupBox name="bottomTimeGB" style="width: 100%; height: 50%; align-items: flex-start; justify-content: flex-end; padding-left: 0; padding-top: 0; padding-bottom: 0; margin-bottom: 0; margin-top: 0; margin-right: 0; margin-left: 0;">
            <ui:Label text="3 Master Balls remaining" display-tooltip-when-elided="true" name="masterballCounter" style="position: relative; bottom: 3%; font-size: 48px; -unity-font: url(&apos;project://database/Assets/UI%20Toolkit/Fonts/Lemon%20Days.otf?fileID=12800000&amp;guid=0c0e763d87c17ee418dbabe25d0345fa&amp;type=3#Lemon Days&apos;); -unity-font-definition: url(&apos;project://database/Assets/UI%20Toolkit/Fonts/Lemon%20Days%20SDF.asset?fileID=11400000&amp;guid=a44f0cf795c97f442acea67148c6ee45&amp;type=2#Lemon Days SDF&apos;); color: rgb(255, 204, 0); text-shadow: 3px 3px 0 rgb(0, 34, 119); align-items: stretch; margin-right: 0; margin-top: 0; margin-left: 24px; margin-bottom: 12px; padding-bottom: 4px;" />
        </ui:GroupBox>
    </ui:GroupBox>
    <ui:GroupBox name="report" style="flex-shrink: 1; flex-grow: 1; align-items: center; display: none;">
