                <ui:Label text="Line1" display-tooltip-when-elided="true" name="line1" style="position: relative; bottom: 3%; font-size: 48px; -unity-font: url(&apos;project://database/Assets/UI%20Toolkit/Fonts/Lemon%20Days.otf?fileID=12800000&amp;guid=0c0e763d87c17ee418dbabe25d0345fa&amp;type=3#Lemon Days&apos;); -unity-font-definition: url(&apos;project://database/Assets/UI%20Toolkit/Fonts/Lemon%20Days%20SDF.asset?fileID=11400000&amp;guid=a44f0cf795c97f442acea67148c6ee45&amp;type=2#Lemon Days SDF&apos;); color: rgb(255, 204, 0); text-shadow: 3px 3px 0 rgb(0, 34, 119); align-items: stretch; margin-right: 12px; margin-top: 12px;" />
                <ui:Label text="Line2" display-tooltip-when-elided="true" name="line2" style="position: relative; bottom: 3%; font-size: 48px; -unity-font: url(&apos;project://database/Assets/UI%20Toolkit/Fonts/Lemon%20Days.otf?fileID=12800000&amp;guid=0c0e763d87c17ee418dbabe25d0345fa&amp;type=3#Lemon Days&apos;); -unity-font-definition: url(&apos;project://database/Assets/UI%20Toolkit/Fonts/Lemon%20Days%20SDF.asset?fileID=11400000&amp;guid=a44f0cf795c97f442acea67148c6ee45&amp;type=2#Lemon Days SDF&apos;); color: rgb(255, 204, 0); text-shadow: 3px 3px 0 rgb(0, 34, 119); align-items: stretch; margin-right: 12px; margin-top: 12px;" />
